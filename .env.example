# Clerk Auth — skapa gratis konto på https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY
CLERK_SECRET_KEY=sk_test_YOUR_KEY
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon Database (serverless PostgreSQL) — skapa gratis på https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/affarskoll?sslmode=require

# App — sätt till din publika URL i produktion (används för og-bilder m.m.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI-assistenten (valfritt) — utan nyckel är AI-chatten och momstolkningen avstängda
# Skapa nyckel på https://console.anthropic.com
ANTHROPIC_API_KEY=

# Skyddar cron-endpoints (/api/cron/*) — sätt till en lång slumpsträng.
# Vercel skickar den automatiskt som Authorization-header för schemalagda jobb.
CRON_SECRET=
